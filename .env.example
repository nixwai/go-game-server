# 本地运行时会自动读取当前工作目录下的 .env，已存在的进程环境变量优先。
# 应用运行环境：development、test 或 production。
APP_ENV=development

# HTTP 服务监听地址，格式为 host:port。
HTTP_ADDR=:8080

# GORM 使用的 MySQL DSN。
# 生产环境必须替换为安全的数据库账号、密码和地址，禁止提交真实连接串。
MYSQL_DSN=go_game:go_game@tcp(127.0.0.1:3306)/go_game?charset=utf8mb4&parseTime=True&loc=Local

# golang-migrate 使用的 MySQL URL。
# 该配置仅用于执行数据库迁移，不被 HTTP 服务启动流程使用。
MYSQL_MIGRATE_URL=mysql://go_game:go_game@tcp(127.0.0.1:3306)/go_game

# HS256 JWT 签名密钥，至少 32 字节。
# 必须替换为高熵随机值，禁止使用示例值或将真实密钥提交到代码仓库。
JWT_SECRET=replace-with-at-least-32-random-bytes

# JWT 签发方，解析令牌时会进行校验。
JWT_ISSUER=go-game-server

# Access Token 有效期，使用 Go time.ParseDuration 格式。
JWT_EXPIRES_IN=2h

# Argon2id 时间成本，数值越高计算成本越高。
ARGON2_TIME=1

# Argon2id 内存成本，单位为 KiB。
ARGON2_MEMORY=65536

# Argon2id 并行线程数。
ARGON2_THREADS=4

# Argon2id 输出哈希长度，单位为字节。
ARGON2_KEY_LEN=32

# Argon2id 随机盐长度，单位为字节。
ARGON2_SALT_LEN=16
