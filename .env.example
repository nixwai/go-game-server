# 本地运行时会自动读取当前工作目录下的 .env，已存在的进程环境变量优先。
# 应用运行环境：development、test 或 production。
APP_ENV=development

# HTTP 服务监听地址，格式为 host:port。
HTTP_ADDR=:8080

# GORM 使用的 MySQL DSN。
# 生产环境必须替换为安全的数据库账号、密码和地址，禁止提交真实连接串。
MYSQL_DSN=go_game:replace-with-database-password@tcp(127.0.0.1:3306)/go_game?charset=utf8mb4&parseTime=True&loc=Local

# golang-migrate 使用的 MySQL URL。
# 该配置仅用于执行数据库迁移，不被 HTTP 服务启动流程使用。
MYSQL_MIGRATE_URL=mysql://go_game:replace-with-database-password@tcp(127.0.0.1:3306)/go_game

# Docker Compose 数据库初始化配置，真实值只允许写入本机 .env。
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=go-game
MYSQL_USER=go_game
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_PORT=3306
# 为空时使用 Docker 命名卷；Windows 示例：D:/Data/mysql-go-game；Linux 示例：/data/mysql-go-game。
MYSQL_DATA_PATH=

# Docker 映射到宿主机的 HTTP 端口。
HTTP_PORT=8080

# 容器时区。
TZ=Asia/Shanghai

# HS256 JWT 签名密钥，至少 32 字节。
# 必须替换为高熵随机值，禁止使用示例值或将真实密钥提交到代码仓库。
JWT_SECRET=replace-with-at-least-32-random-bytes

# JWT 签发方，解析令牌时会进行校验。
JWT_ISSUER=go-game-server

# Access Token 有效期，使用 Go time.ParseDuration 格式。
JWT_EXPIRES_IN=2h

# Argon2id 时间成本，数值越高计算成本越高。
ARGON2_TIME=1

# Argon2id 内存成本，单位为 KiB。
ARGON2_MEMORY=65536

# Argon2id 并行线程数。
ARGON2_THREADS=4

# Argon2id 输出哈希长度，单位为字节。
ARGON2_KEY_LEN=32

# Argon2id 随机盐长度，单位为字节。
ARGON2_SALT_LEN=16

# AES-256-GCM 主密钥，base64 编码的 32 字节（256 位）随机值。
# 用于加密存储用户配置的 AI API Key。必须替换为高熵随机值，禁止使用示例值。
# 可通过以下命令生成：openssl rand 32 | base64
MASTER_KEY=replace-with-base64-encoded-32-random-bytes

# 默认 AI 产商和模型配置，通过配置文件提供，对所有用户只读，不入数据库。
# 用户不可修改或删除此配置。
DEFAULT_AI_PROVIDER=OpenAI
DEFAULT_AI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_MODEL=gpt-4o-mini
# 默认产商的 API Key，直接存于内存，不入库。
# 生产环境必须替换为真实 Key，禁止将真实 Key 提交到代码仓库。
DEFAULT_AI_API_KEY=replace-with-your-api-key

# LLM API 调用超时时间，使用 Go time.ParseDuration 格式。
GO_LLM_TIMEOUT=30s


# 每日用户注册上限。-1 表示无限制，0 表示禁止注册，正数表示当天最大注册数。
DAILY_REGISTER_LIMIT=-1

# 每个用户最多可配置的 AI 产商数量，-1 表示无限制。
MAX_PROVIDERS_PER_USER=10

# 每个产商下最多可配置的 AI 模型数量，-1 表示无限制。
MAX_MODELS_PER_PROVIDER=20
